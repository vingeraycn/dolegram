{
  "name": "dolegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  },
  "scripts": {
    "start": "python3 scripts/run-backend.py",
    "test": "node scripts/check-runtime.mjs && node --test",
    "check": "node scripts/check-runtime.mjs && tsc --noEmit && eslint .",
    "configure": "python3 scripts/configure.py",
    "build:sites": "node scripts/check-runtime.mjs && node scripts/build-sites.mjs",
    "verify:local": "node scripts/check-runtime.mjs && node scripts/verify-local.mjs",
    "probe:local": "node scripts/probe-server.mjs",
    "doctor": "node scripts/check-runtime.mjs && node scripts/doctor.mjs"
  },
  "dependencies": {
    "ipaddr.js": "2.2.0",
    "standardwebhooks": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "description": "Use ChatGPT Dot in Telegram."
}
